# AI Mode: "cloud" (Azure GPT-4o) or "local" (Gemma GPU)
AI_MODE=cloud

# Azure OpenAI — required when AI_MODE=cloud
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_API_KEY=<your-api-key>
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Gemma (local GPU) — used as fallback or when AI_MODE=local
GEMMA_ENDPOINT=http://100.99.128.76:11434/v1/chat/completions
GEMMA_MODEL=gemma4:26b
